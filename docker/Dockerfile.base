FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Sistem bagimliliklari (build + runtime tek katman, apt cache silinir)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /root/.cache

# PyTorch CUDA 12.1 (tek seferde, CPU surumu kurulmaz)
RUN pip install --no-cache-dir \
    torch==2.4.1 \
    torchvision==0.19.1 \
    --index-url https://download.pytorch.org/whl/cu121

# Diger ortak paketler
RUN pip install --no-cache-dir \
    "numpy>=1.26.4,<2.0" \
    "pandas>=2.2" \
    "scikit-learn>=1.5" \
    "pillow>=10.4.0,<11.0" \
    "matplotlib>=3.9" \
    "seaborn>=0.13" \
    "tqdm>=4.70" \
    && find /usr/local/lib/python3.12 -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true

LABEL maintainer="Eray" \
    description="ChefAI base - PyTorch 2.4.1+cu121"

WORKDIR /app
